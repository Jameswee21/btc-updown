rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 전 세계 명예의 전당: 누구나 읽기 가능, 쓰기는 형식 검증 통과 시에만
    match /leaderboard/{entry} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'sats', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.sats is int
        && request.resource.data.sats > 0
        && request.resource.data.sats <= 1000000000
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
